<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/imageview_chat_left_item_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_rudolf_ic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_left_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/dark_gray"
            android:textFontWeight="600"
            android:textSize="13dp"
            app:layout_constraintStart_toEndOf="@id/imageview_chat_left_item_logo"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="익명의 마니또" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_left_item_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_gray3_fill_leftchat"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/dark_gray"
            android:textFontWeight="500"
            android:textSize="15dp"
            app:layout_constraintStart_toEndOf="@id/imageview_chat_left_item_logo"
            app:layout_constraintTop_toBottomOf="@id/textview_chat_left_item_name"
            tools:text="안녕하세요저는당신의" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_left_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/dark_gray"
            android:textFontWeight="400"
            android:textSize="11dp"
            app:layout_constraintBottom_toBottomOf="@id/textview_chat_left_item_content"
            app:layout_constraintStart_toEndOf="@id/textview_chat_left_item_content"
            tools:text="12:34" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>