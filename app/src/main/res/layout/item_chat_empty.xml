<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_empty_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_light_gray_fill_50_rect"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textColor="@color/dark_gray"
            android:textFontWeight="400"
            android:textSize="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2025년 4월 27일" />

        <ImageView
            android:id="@+id/imageview_chat_empty_item_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_santa_ic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textview_chat_empty_item_date" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_empty_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="산타마니또"
            android:textColor="@color/dark_gray"
            android:textFontWeight="600"
            android:textSize="12dp"
            app:layout_constraintStart_toEndOf="@id/imageview_chat_empty_item_logo"
            app:layout_constraintTop_toBottomOf="@id/textview_chat_empty_item_date" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_empty_item_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/shape_dark_gray_fill_leftchat"
            android:lineSpacingMultiplier="1.1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="마니또에게 응원의 메시지를 보내볼까?\n메세지는 10자 이내로 보낼 수 있어!"
            android:textColor="@color/white"
            android:textFontWeight="500"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/imageview_chat_empty_item_logo"
            app:layout_constraintTop_toBottomOf="@id/textview_chat_empty_item_name" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chat_left_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/dark_gray"
            android:textFontWeight="400"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@id/textview_chat_empty_item_content"
            app:layout_constraintStart_toEndOf="@id/textview_chat_empty_item_content"
            tools:text="12:34" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>